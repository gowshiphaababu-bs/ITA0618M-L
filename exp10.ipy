    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.mixture import GaussianMixture\n",
        "\n",
        "# Generate dataset\n",
        "np.random.seed(42)\n",
        "\n",
        "X1 = np.random.normal(2, 0.5, (100, 2))\n",
        "X2 = np.random.normal(5, 0.5, (100, 2))\n",
        "\n",
        "X = np.vstack((X1, X2))\n",
        "\n",
        "# Create EM model\n",
        "model = GaussianMixture(\n",
        "    n_components=2,\n",
        "    random_state=42,\n",
        "    max_iter=100\n",
        ")\n",
        "\n",
        "# Train model\n",
        "model.fit(X)\n",
        "\n",
        "# Predict clusters\n",
        "labels = model.predict(X)\n",
        "\n",
        "# Display results\n",
        "print(\"Cluster Labels:\")\n",
        "print(labels)\n",
        "\n",
        "print(\"\\nCluster Means:\")\n",
        "print(model.means_)\n",
        "\n",
        "print(\"\\nNumber of Iterations:\")\n",
        "print(model.n_iter_)\n",
        "\n",
        "print(\"\\nConverged:\", model.converged_)\n",
        "\n",
        "# Visualization\n",
        "plt.scatter(X[:, 0], X[:, 1], c=labels, cmap='viridis')\n",
        "plt.title(\"Expectation Maximization - GMM\")\n",
        "plt.xlabel(\"Feature 1\")\n",
        "plt.ylabel(\"Feature 2\")\n",
        "plt.show()"
      ],
