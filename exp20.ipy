    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from sklearn.linear_model import LinearRegression\n",
        "from sklearn.metrics import mean_absolute_error, r2_score\n",
        "\n",
        "# Generate sample monthly sales dataset\n",
        "np.random.seed(42)\n",
        "\n",
        "months = np.arange(1, 25)\n",
        "\n",
        "sales = (\n",
        "    10000\n",
        "    + months * 500\n",
        "    + 2000 * np.sin(2 * np.pi * months / 12)\n",
        "    + np.random.normal(0, 500, 24)\n",
        ")\n",
        "\n",
        "# Create DataFrame\n",
        "df = pd.DataFrame({\n",
        "    'Month': months,\n",
        "    'Sales': sales\n",
        "})\n",
        "\n",
        "print(\"Sales Dataset:\")\n",
        "print(df)\n",
        "\n",
        "# Features and target\n",
        "X = df[['Month']]\n",
        "y = df['Sales']\n",
        "\n",
        "# Use first 20 months for training\n",
        "X_train = X.iloc[:20]\n",
        "y_train = y.iloc[:20]\n",
        "\n",
        "# Use last 4 months for testing\n",
        "X_test = X.iloc[20:]\n",
        "y_test = y.iloc[20:]\n",
        "\n",
        "# Create model\n",
        "model = LinearRegression()\n",
        "\n",
        "# Train model\n",
        "model.fit(X_train, y_train)\n",
        "\n",
        "# Test prediction\n",
        "y_pred = model.predict(X_test)\n",
        "\n",
        "# Evaluation\n",
        "print(\"\\nMean Absolute Error:\", mean_absolute_error(y_test, y_pred))\n",
        "print(\"R2 Score:\", r2_score(y_test, y_pred))\n",
        "\n",
        "# Predict next 6 months\n",
        "future_months = pd.DataFrame({\n",
        "    'Month': np.arange(25, 31)\n",
        "})\n",
        "\n",
        "future_sales = model.predict(future_months)\n",
        "\n",
        "print(\"\\nFuture Sales Prediction:\")\n",
        "\n",
        "for month, sale in zip(future_months['Month'], future_sales):\n",
        "    print(\"Month\", month, \"Predicted Sales:\", round(sale, 2))\n",
        "\n",
        "# Visualization\n",
        "plt.figure(figsize=(10, 5))\n",
        "\n",
        "plt.plot(months, sales, marker='o', label='Actual Sales')\n",
        "plt.plot(X_test['Month'], y_pred, marker='s', label='Test Prediction')\n",
        "plt.plot(\n",
        "    future_months['Month'],\n",
        "    future_sales,\n",
        "    marker='*',\n",
        "    linestyle='--',\n",
        "    label='Future Sales'\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Month\")\n",
        "plt.ylabel(\"Sales\")\n",
        "plt.title(\"Future Sales Prediction\")\n",
        "plt.legend()\n",
        "plt.grid()\n",
        "plt.show()"
      ],
